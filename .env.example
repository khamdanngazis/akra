# Salin ke .env lalu sesuaikan. Jangan commit file .env.
# Nilai di bawah cocok dengan docker-compose.yml (khusus lokal).
DATABASE_URL=postgres://akra:akra@localhost:5432/akra?sslmode=disable
DB_MAX_CONNS=10
# Jumlah job latar belakang (River) yang berjalan bersamaan.
RIVER_WORKERS=4
PORT=8080
APP_ENV=development
# Wajib di staging/production. Di development default http://localhost:$PORT.
# APP_BASE_URL=https://app.akra.id
# Biaya argon2id (default: batas minimum OWASP)
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1

# Development: baca template dan aset dari disk agar cukup restart, tanpa rebuild.
# WEB_DIR=web

# Email. log = hanya ditulis ke log (dev/staging). Production wajib resend.
MAIL_DRIVER=log
# MAIL_FROM="AKRA <no-reply@akra.id>"
# MAIL_DRIVER=resend → isi juga MAIL_FROM (domain terverifikasi di Resend) dan RESEND_API_KEY
# RESEND_API_KEY=

# Penyimpanan file privat (bukti transfer). local = disk (development/staging; ditolak di production).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=data/storage
# STORAGE_DRIVER=r2 → wajib (bucket PRIVAT, public access dan r2.dev dimatikan):
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
