# Salin ke .env lalu sesuaikan. Jangan commit file .env.
# Nilai di bawah cocok dengan docker-compose.yml (khusus lokal).
DATABASE_URL=postgres://akra:akra@localhost:5432/akra?sslmode=disable
DB_MAX_CONNS=10
PORT=8080
APP_ENV=development
# Biaya argon2id (default: batas minimum OWASP)
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
